{
  "name": "cross-the-roads",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": { "node": ">=22" },
  "pnpm": { "onlyBuiltDependencies": ["esbuild"] },
  "scripts": {
    "dev": "pnpm --filter @cross-the-roads/web dev",
    "build": "pnpm --filter @cross-the-roads/web build",
    "preview": "pnpm --filter @cross-the-roads/web preview",
    "typecheck": "pnpm --filter @cross-the-roads/web exec tsc -b",
    "test": "pnpm --filter @cross-the-roads/web test"
  }
}
